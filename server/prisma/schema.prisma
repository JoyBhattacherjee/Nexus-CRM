generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  SALES
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(SALES)
  avatar      String?
  active      Boolean      @default(true)
  leads       Lead[]       @relation("LeadOwner")
  deals       Deal[]       @relation("DealOwner")
  tasks       Task[]       @relation("TaskAssignee")
  coursesMade Course[]     @relation("CourseCreator")
  enrollments Enrollment[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Lead {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      LeadStatus  @default(NEW)
  value       Decimal?    @db.Decimal(12, 2)
  notes       String?
  ownerId     String
  owner       User        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activities  Activity[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?
  company   String?
  jobTitle  String?
  city      String?
  country   String?
  notes     String?
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  company     String?
  value       Decimal   @db.Decimal(12, 2)
  stage       DealStage @default(PROSPECTING)
  probability Int       @default(10)
  closeDate   DateTime?
  notes       String?
  ownerId     String
  owner       User      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([stage])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([assigneeId])
  @@index([status])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  category    String
  level       String
  published   Boolean      @default(false)
  thumbnail   String?
  creatorId   String
  creator     User         @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  content   String
  videoUrl  String?
  position  Int
  duration  Int      @default(10)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  progress   Int              @default(0)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  completedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  userId    String
  leadId    String?
  dealId    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}
